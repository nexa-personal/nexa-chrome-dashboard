{
  "manifest_version": 3,
  "name": "NEXA",
  "short_name": "NEXA",
  "version": "0.6.1",
  "description": "NEXA is a customizable personal New Tab dashboard for Chrome with weather, markets, world clock, network tools, tasks, bookmarks and RSS news.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "geolocation"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.coingecko.com/*",
    "https://api.frankfurter.dev/*",
    "https://api.frankfurter.app/*",
    "https://*.tgju.org/*",
    "https://news.google.com/*",
    "https://ipwho.is/*",
    "https://api.ipify.org/*",
    "https://www.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https://www.google.com;"
  }
}
